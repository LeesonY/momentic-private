{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "RunEvent": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "id": {
          "type": "string",
          "maxLength": 30,
          "pattern": "^[1-9][0-9]*$"
        },
        "runId": {
          "type": "string",
          "format": "uuid"
        },
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "run.updated",
            "phase.changed",
            "task.updated",
            "case.created",
            "case.result",
            "finding.updated",
            "step.recorded",
            "budget.updated",
            "input.requested",
            "input.resolved",
            "artifact.updated",
            "report.ready",
            "run.finished",
            "session.updated"
          ]
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "payload": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          }
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "runId",
        "seq",
        "type",
        "at",
        "payload"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "session.updated"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/SessionReport"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "run.updated"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/Run"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "phase.changed"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "properties": {
                  "phase": {
                    "type": "string",
                    "enum": [
                      "preflight",
                      "auth",
                      "explore",
                      "plan",
                      "execute",
                      "reproduce",
                      "finalize"
                    ]
                  },
                  "contextVersion": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "phase",
                  "contextVersion"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "task.updated"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/Task"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "case.created"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/CaseDefinition"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "case.result"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/CaseRecord"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "finding.updated"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/Finding"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "step.recorded"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/Step"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "budget.updated"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "properties": {
                  "used": {
                    "$ref": "#/$defs/BudgetUsed"
                  },
                  "limits": {
                    "$ref": "#/$defs/BudgetLimits"
                  }
                },
                "required": [
                  "used",
                  "limits"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "input.requested"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/InputRequest"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "input.resolved"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/InputRequest"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "artifact.updated"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/Artifact"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "report.ready"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "properties": {
                  "schemaVersion": {
                    "const": 1
                  },
                  "reportVersion": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "generatedAt": {
                    "type": "string",
                    "format": "date-time"
                  }
                },
                "required": [
                  "schemaVersion",
                  "reportVersion",
                  "generatedAt"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "run.finished"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/Run"
              }
            }
          }
        }
      ]
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JsonValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          }
        }
      ]
    },
    "SessionReport": {
      "type": "object",
      "properties": {
        "objective": {
          "type": "string",
          "maxLength": 4000
        },
        "round": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "status": {
          "type": "string",
          "enum": [
            "planning",
            "working",
            "reviewing",
            "finalizing",
            "complete"
          ]
        },
        "plan": {
          "type": "string",
          "maxLength": 2000
        },
        "caseIds": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "maxItems": 30,
          "minItems": 0
        },
        "exploredUrls": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri",
            "maxLength": 8192,
            "pattern": "^https?://"
          },
          "maxItems": 30,
          "minItems": 0
        },
        "coverageGaps": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2000
          },
          "maxItems": 100,
          "minItems": 0
        },
        "summary": {
          "type": "string",
          "maxLength": 4000
        },
        "history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SessionRound"
          },
          "maxItems": 6,
          "minItems": 0
        },
        "messageCursor": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "objective",
        "round",
        "status",
        "plan",
        "caseIds",
        "exploredUrls",
        "coverageGaps",
        "summary",
        "history"
      ],
      "additionalProperties": false
    },
    "SessionRound": {
      "type": "object",
      "properties": {
        "round": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "reason": {
          "type": "string",
          "maxLength": 2000
        },
        "caseIds": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "maxItems": 30,
          "minItems": 0
        },
        "exploreTargets": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri",
            "maxLength": 8192,
            "pattern": "^https?://"
          },
          "maxItems": 30,
          "minItems": 0
        }
      },
      "required": [
        "round",
        "reason",
        "caseIds",
        "exploreTargets"
      ],
      "additionalProperties": false
    },
    "Run": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "projectId": {
          "type": "string",
          "format": "uuid"
        },
        "creatorId": {
          "type": "string",
          "format": "uuid"
        },
        "targetUrl": {
          "type": "string",
          "format": "uri",
          "maxLength": 8192,
          "pattern": "^https?://"
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "queued",
            "running",
            "awaiting_input",
            "cancelling",
            "completed",
            "cancelled",
            "failed"
          ]
        },
        "phase": {
          "type": "string",
          "enum": [
            "preflight",
            "auth",
            "explore",
            "plan",
            "execute",
            "reproduce",
            "finalize"
          ]
        },
        "completion": {
          "type": "string",
          "enum": [
            "complete",
            "partial",
            "none"
          ]
        },
        "terminationReason": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "normal",
                "budget_limit",
                "input_timeout",
                "user_cancel",
                "worker_failure",
                "model_failure",
                "setup_failure"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "contextVersion": {
          "type": "integer",
          "minimum": 1
        },
        "effectiveConfig": {
          "$ref": "#/$defs/RunConfig"
        },
        "budgetUsed": {
          "$ref": "#/$defs/BudgetUsed"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "executionMode": {
          "type": "string",
          "enum": [
            "smoke",
            "regression"
          ]
        }
      },
      "required": [
        "id",
        "projectId",
        "creatorId",
        "targetUrl",
        "status",
        "phase",
        "completion",
        "terminationReason",
        "contextVersion",
        "effectiveConfig",
        "budgetUsed",
        "createdAt",
        "updatedAt",
        "version"
      ],
      "additionalProperties": false
    },
    "RunConfig": {
      "type": "object",
      "properties": {
        "allowedOrigins": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri",
            "maxLength": 8192,
            "pattern": "^https?://"
          },
          "maxItems": 30,
          "minItems": 1
        },
        "actionPolicy": {
          "type": "string",
          "enum": [
            "non_submitting",
            "approved_workflows"
          ]
        },
        "budget": {
          "$ref": "#/$defs/BudgetLimits"
        },
        "environmentVersion": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "authProfileVersion": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "knowledgeVersionIds": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "maxItems": 100,
          "minItems": 0
        },
        "taskIntent": {
          "$ref": "#/$defs/TaskIntent"
        },
        "writeScope": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri",
            "maxLength": 8192,
            "pattern": "^https?://"
          },
          "maxItems": 20,
          "minItems": 0
        },
        "previousRunId": {
          "type": "string",
          "format": "uuid"
        },
        "models": {
          "$ref": "#/$defs/RoleModels"
        }
      },
      "required": [
        "allowedOrigins",
        "actionPolicy",
        "budget",
        "environmentVersion",
        "authProfileVersion",
        "knowledgeVersionIds",
        "models"
      ],
      "additionalProperties": false
    },
    "BudgetLimits": {
      "type": "object",
      "properties": {
        "maxCases": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30,
          "default": 8
        },
        "maxPages": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30,
          "default": 6
        },
        "maxDepth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5,
          "default": 2
        },
        "maxActiveSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 3600,
          "default": 600
        },
        "maxActionsPerCase": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30,
          "default": 12
        },
        "maxActions": {
          "type": "integer",
          "minimum": 10,
          "maximum": 1000,
          "default": 120
        },
        "maxModelCalls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 100
        },
        "maxReproductions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10,
          "default": 3
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16,
          "default": 2
        },
        "maxTotalTokens": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 5000000,
          "default": 300000
        }
      },
      "required": [
        "maxCases",
        "maxPages",
        "maxDepth",
        "maxActiveSeconds",
        "maxActionsPerCase",
        "maxActions",
        "maxModelCalls",
        "maxReproductions",
        "concurrency",
        "maxTotalTokens"
      ],
      "additionalProperties": false
    },
    "TaskIntent": {
      "type": "string",
      "enum": [
        "flow",
        "explore",
        "reproduce",
        "plan",
        "changes",
        "spec"
      ]
    },
    "RoleModels": {
      "type": "object",
      "properties": {
        "coordinator": {
          "$ref": "#/$defs/ModelBinding"
        },
        "explorer": {
          "$ref": "#/$defs/ModelBinding"
        },
        "executor": {
          "$ref": "#/$defs/ModelBinding"
        },
        "assertion": {
          "$ref": "#/$defs/ModelBinding"
        },
        "reproducer": {
          "$ref": "#/$defs/ModelBinding"
        }
      },
      "required": [
        "coordinator",
        "explorer",
        "executor",
        "assertion",
        "reproducer"
      ],
      "additionalProperties": false
    },
    "ModelBinding": {
      "type": "object",
      "properties": {
        "profileId": {
          "type": "string",
          "format": "uuid"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "profileId",
        "version"
      ],
      "additionalProperties": false
    },
    "BudgetUsed": {
      "type": "object",
      "properties": {
        "activeSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "actions": {
          "type": "integer",
          "minimum": 0
        },
        "modelCalls": {
          "type": "integer",
          "minimum": 0
        },
        "reproductions": {
          "type": "integer",
          "minimum": 0
        },
        "totalTokens": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "activeSeconds",
        "actions",
        "modelCalls",
        "reproductions",
        "totalTokens"
      ],
      "additionalProperties": false
    },
    "Task": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "runId": {
          "type": "string",
          "format": "uuid"
        },
        "role": {
          "type": "string",
          "enum": [
            "coordinator",
            "explorer",
            "executor",
            "reproducer",
            "finalizer"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "queued",
            "running",
            "waiting",
            "succeeded",
            "failed",
            "cancelled",
            "interrupted"
          ]
        },
        "caseId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "summary": {
          "type": "string",
          "maxLength": 4000
        },
        "elapsedSeconds": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "runId",
        "role",
        "status",
        "caseId",
        "attempt",
        "summary",
        "elapsedSeconds"
      ],
      "additionalProperties": false
    },
    "CaseDefinition": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "runId": {
          "type": "string",
          "format": "uuid"
        },
        "projectId": {
          "type": "string",
          "format": "uuid"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "maxLength": 200,
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "maxLength": 4000
        },
        "preconditions": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1000
          },
          "maxItems": 20,
          "minItems": 0
        },
        "outline": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1500
          },
          "maxItems": 30,
          "minItems": 1
        },
        "criteria": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Criterion"
          },
          "maxItems": 20,
          "minItems": 1
        },
        "regression": {
          "$ref": "#/$defs/RegressionBinding"
        }
      },
      "required": [
        "id",
        "runId",
        "projectId",
        "version",
        "title",
        "summary",
        "preconditions",
        "outline",
        "criteria"
      ],
      "additionalProperties": false
    },
    "Criterion": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_.-]+$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "element_visible",
            "text_equals",
            "url_matches",
            "http_status",
            "semantic",
            "visual"
          ]
        },
        "description": {
          "type": "string",
          "maxLength": 2000,
          "minLength": 1
        },
        "sourceKind": {
          "type": "string",
          "enum": [
            "generic_smoke",
            "user_spec",
            "project_knowledge",
            "saved_case",
            "inferred"
          ]
        },
        "sourceRef": {
          "type": "string",
          "maxLength": 500,
          "minLength": 1
        },
        "locator": {
          "$ref": "#/$defs/Locator"
        },
        "expectedValue": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "required": [
        "id",
        "kind",
        "description",
        "sourceKind",
        "sourceRef"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "element_visible",
                  "text_equals"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "locator"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "text_equals",
                  "url_matches",
                  "http_status"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "expectedValue"
            ]
          }
        }
      ]
    },
    "Locator": {
      "type": "object",
      "properties": {
        "by": {
          "type": "string",
          "enum": [
            "role",
            "label",
            "test_id",
            "text",
            "css"
          ]
        },
        "value": {
          "type": "string",
          "maxLength": 500,
          "minLength": 1
        },
        "name": {
          "type": "string",
          "maxLength": 500
        }
      },
      "required": [
        "by",
        "value"
      ],
      "additionalProperties": false
    },
    "RegressionBinding": {
      "type": "object",
      "properties": {
