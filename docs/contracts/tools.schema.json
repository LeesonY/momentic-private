{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ToolCall": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "name": {
              "const": "observe"
            },
            "args": {
              "type": "object",
              "properties": {
                "pageId": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "required": [],
              "additionalProperties": false
            }
          },
          "required": [
            "name",
            "args"
          ],
          "additionalProperties": false,
          "x-roles": [
            "explorer",
            "executor",
            "reproducer"
          ],
          "x-result-schema": {
            "$ref": "#/$defs/BrowserSnapshot"
          }
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "const": "navigate"
            },
            "args": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri",
                  "maxLength": 8192,
                  "pattern": "^https?://"
                }
              },
              "required": [
                "url"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "name",
            "args"
          ],
          "additionalProperties": false,
          "x-roles": [
            "explorer",
            "executor",
            "reproducer"
          ],
          "x-result-schema": {
            "$ref": "#/$defs/BrowserSnapshot"
          }
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "const": "click"
            },
            "args": {
              "type": "object",
              "properties": {
                "target": {
                  "$ref": "#/$defs/NodeTarget"
                }
              },
              "required": [
                "target"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "name",
            "args"
          ],
          "additionalProperties": false,
          "x-roles": [
            "explorer",
            "executor",
            "reproducer"
          ],
          "x-result-schema": {
            "$ref": "#/$defs/BrowserSnapshot"
          }
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "const": "type_text"
            },
            "args": {
              "type": "object",
              "properties": {
                "target": {
                  "$ref": "#/$defs/NodeTarget"
                },
                "text": {
                  "type": "string",
                  "maxLength": 2000
                }
              },
              "required": [
                "target",
                "text"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "name",
            "args"
          ],
          "additionalProperties": false,
          "x-roles": [
            "explorer",
            "executor",
            "reproducer"
          ],
          "x-result-schema": {
            "$ref": "#/$defs/BrowserSnapshot"
          }
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "const": "select_option"
            },
            "args": {
              "type": "object",
              "properties": {
                "target": {
                  "$ref": "#/$defs/NodeTarget"
                },
                "value": {
                  "type": "string",
                  "maxLength": 500
                }
              },
              "required": [
                "target",
                "value"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "name",
            "args"
          ],
          "additionalProperties": false,
          "x-roles": [
            "explorer",
            "executor",
            "reproducer"
          ],
          "x-result-schema": {
            "$ref": "#/$defs/BrowserSnapshot"
          }
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "const": "press"
            },
            "args": {
              "type": "object",
              "properties": {
                "target": {
                  "$ref": "#/$defs/NodeTarget"
                },
                "key": {
                  "type": "string",
                  "enum": [
                    "Enter",
                    "Escape",
                    "Tab",
                    "ArrowUp",
                    "ArrowDown"
                  ]
                }
              },
              "required": [
                "target",
                "key"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "name",
            "args"
          ],
          "additionalProperties": false,
          "x-roles": [
            "explorer",
            "executor",
            "reproducer"
          ],
          "x-result-schema": {
            "$ref": "#/$defs/BrowserSnapshot"
          }
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "const": "scroll"
            },
            "args": {
              "type": "object",
              "properties": {
                "pageId": {
                  "type": "string",
                  "format": "uuid"
                },
                "direction": {
                  "type": "string",
                  "enum": [
                    "up",
                    "down"
                  ]
                },
                "pixels": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2000
                }
              },
              "required": [
                "pageId",
                "direction",
                "pixels"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "name",
            "args"
          ],
          "additionalProperties": false,
          "x-roles": [
            "explorer",
            "executor",
            "reproducer"
          ],
          "x-result-schema": {
            "$ref": "#/$defs/BrowserSnapshot"
          }
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "const": "wait_for"
            },
            "args": {
              "type": "object",
              "properties": {
                "pageId": {
                  "type": "string",
                  "format": "uuid"
                },
                "condition": {
                  "type": "string",
                  "enum": [
                    "dom_ready",
                    "navigation",
                    "element_visible"
                  ]
                },
                "target": {
                  "$ref": "#/$defs/NodeTarget"
                },
                "timeoutMs": {
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 15000
                }
              },
              "required": [
                "pageId",
                "condition",
                "timeoutMs"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "name",
            "args"
          ],
          "additionalProperties": false,
          "x-roles": [
            "explorer",
            "executor",
            "reproducer"
          ],
          "x-result-schema": {
            "$ref": "#/$defs/BrowserSnapshot"
          }
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "const": "assert_criterion"
            },
            "args": {
              "type": "object",
              "properties": {
                "criterionId": {
                  "type": "string",
                  "maxLength": 64
                }
              },
              "required": [
                "criterionId"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "name",
            "args"
          ],
          "additionalProperties": false,
          "x-roles": [
            "executor",
            "reproducer"
          ],
          "x-result-schema": {
            "$ref": "#/$defs/CriterionResult"
          }
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "const": "inspect_network"
            },
            "args": {
              "type": "object",
              "properties": {
                "pageId": {
                  "type": "string",
                  "format": "uuid"
                },
                "urlContains": {
                  "type": "string",
                  "maxLength": 300
                },
                "limit": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                }
              },
              "required": [
                "pageId",
                "limit"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "name",
            "args"
          ],
          "additionalProperties": false,
          "x-roles": [
            "explorer",
            "executor",
            "reproducer"
          ],
          "x-result-schema": {
            "$ref": "#/$defs/NetworkEntries"
          }
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "const": "capture"
            },
            "args": {
              "type": "object",
              "properties": {
                "pageId": {
                  "type": "string",
                  "format": "uuid"
                },
                "reason": {
                  "type": "string",
                  "maxLength": 1000
                }
              },
              "required": [
                "pageId",
                "reason"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "name",
            "args"
          ],
          "additionalProperties": false,
          "x-roles": [
            "explorer",
            "executor",
            "reproducer"
          ],
          "x-result-schema": {
            "$ref": "#/$defs/Artifact"
          }
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "const": "submit_case"
            },
            "args": {
              "type": "object",
              "properties": {
                "candidate": {
                  "$ref": "#/$defs/CandidateCase"
                }
              },
              "required": [
                "candidate"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "name",
            "args"
          ],
          "additionalProperties": false,
          "x-roles": [
            "explorer",
            "coordinator"
          ],
          "x-result-schema": {
            "$ref": "#/$defs/CaseDefinition"
          }
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "const": "report_suspect"
            },
            "args": {
              "type": "object",
              "properties": {
                "caseId": {
                  "type": "string",
                  "format": "uuid"
                },
                "criterionId": {
                  "type": "string",
                  "maxLength": 64
                },
                "actual": {
                  "type": "string",
                  "maxLength": 2000
                },
                "evidenceRefs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "maxItems": 30,
                  "minItems": 1
                },
                "reproSteps": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 1500
                  },
                  "maxItems": 30,
                  "minItems": 1
                }
              },
              "required": [
                "caseId",
                "criterionId",
                "actual",
                "evidenceRefs",
                "reproSteps"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "name",
            "args"
          ],
          "additionalProperties": false,
          "x-roles": [
            "executor",
            "explorer"
          ],
          "x-result-schema": {
            "$ref": "#/$defs/Finding"
          }
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "const": "finish_case"
            },
            "args": {
              "type": "object",
              "properties": {
                "summary": {
                  "type": "string",
                  "maxLength": 2000
                },
                "gaps": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 1000
                  },
                  "maxItems": 30,
                  "minItems": 0
                }
              },
              "required": [
                "summary",
                "gaps"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "name",
            "args"
          ],
          "additionalProperties": false,
          "x-roles": [
            "executor"
          ],
          "x-result-schema": {
            "$ref": "#/$defs/Verdict"
          }
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "const": "complete_reproduction"
            },
            "args": {
              "type": "object",
              "properties": {
                "outcome": {
                  "type": "string",
                  "enum": [
                    "reproduced",
                    "not_reproduced",
                    "blocked"
                  ]
                },
                "summary": {
                  "type": "string",
                  "maxLength": 2000
                },
                "evidenceRefs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "maxItems": 30,
                  "minItems": 0
                }
              },
              "required": [
                "outcome",
                "summary",
                "evidenceRefs"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "name",
            "args"
          ],
          "additionalProperties": false,
          "x-roles": [
            "reproducer"
          ],
          "x-result-schema": {
            "$ref": "#/$defs/Reproduction"
          }
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "const": "request_input"
            },
            "args": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "auth_profile",
                    "clarification",
                    "scope_extension"
                  ]
                },
                "prompt": {
                  "type": "string",
                  "maxLength": 2000
                }
              },
              "required": [
                "kind",
                "prompt"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "name",
            "args"
          ],
          "additionalProperties": false,
          "x-roles": [
            "coordinator",
            "explorer",
            "executor",
            "reproducer"
          ],
          "x-result-schema": {
            "$ref": "#/$defs/InputRequest"
          }
        }
      ]
    },
    "BrowserSnapshot": {
      "type": "object",
      "properties": {
        "snapshotId": {
          "type": "string",
          "format": "uuid"
        },
        "pageId": {
          "type": "string",
          "format": "uuid"
        },
        "frameIds": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 120
          },
          "maxItems": 100,
          "minItems": 0
        },
        "displayUrl": {
          "type": "string",
          "maxLength": 8192
        },
        "title": {
          "type": "string",
          "maxLength": 500
        },
        "responseStatus": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 100,
              "maximum": 599
            },
            {
              "type": "null"
            }
          ]
        },
        "capturedAt": {
          "type": "string",
          "format": "date-time"
        },
        "stateVersion": {
          "type": "integer",
          "minimum": 1
        },
        "viewport": {
          "type": "object",
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 100,
              "maximum": 10000
            },
            "height": {
              "type": "integer",
              "minimum": 100,
              "maximum": 10000
            }
          },
          "required": [
            "width",
            "height"
          ],
          "additionalProperties": false
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SnapshotNode"
          },
          "maxItems": 1000,
          "minItems": 0
        },
        "screenshotRef": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "networkSummary": {
          "$ref": "#/$defs/NetworkEntries"
        },
        "consoleSummary": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1000
          },
          "maxItems": 50,
          "minItems": 0
        },
        "truncated": {
          "type": "boolean"
        },
        "redacted": {
          "type": "boolean"
        }
      },
      "required": [
        "snapshotId",
        "pageId",
        "frameIds",
        "displayUrl",
        "title",
        "responseStatus",
        "capturedAt",
        "stateVersion",
        "viewport",
        "nodes",
        "screenshotRef",
        "networkSummary",
        "consoleSummary",
        "truncated",
        "redacted"
      ],
      "additionalProperties": false
    },
    "SnapshotNode": {
      "type": "object",
      "properties": {
        "nodeId": {
          "type": "string",
          "maxLength": 120,
          "minLength": 1
        },
        "frameId": {
          "type": "string",
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "maxLength": 120
        },
        "name": {
          "type": "string",
          "maxLength": 1000
        },
        "text": {
          "type": "string",
          "maxLength": 2000
        },
        "visible": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean"
        },
        "bounds": {
          "$ref": "#/$defs/Bounds"
        },
        "inputType": {
          "type": "string",
          "maxLength": 40
        },
        "sensitive": {
          "type": "boolean"
        }
      },
      "required": [
        "nodeId",
        "frameId",
        "role",
        "name",
        "text",
        "visible",
        "enabled",
        "bounds"
      ],
      "additionalProperties": false
    },
    "Bounds": {
      "type": "object",
      "properties": {
        "left": {
          "type": "number"
        },
        "top": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "minimum": 0
        },
        "height": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "left",
        "top",
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "NetworkEntries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/NetworkEntry"
      },
      "maxItems": 100,
      "minItems": 0
    },
    "NetworkEntry": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "maxLength": 8192
        },
        "method": {
          "type": "string",
          "maxLength": 20
        },
        "status": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 100,
              "maximum": 599
            },
            {
              "type": "null"
            }
          ]
        },
        "resourceType": {
          "type": "string",
          "maxLength": 40
        },
        "summary": {
          "type": "string",
          "maxLength": 1000
        }
      },
      "required": [
        "url",
        "method",
        "status",
        "resourceType",
        "summary"
      ],
      "additionalProperties": false
    },
    "NodeTarget": {
      "type": "object",
      "properties": {
        "snapshotId": {
          "type": "string",
          "format": "uuid"
        },
        "pageId": {
          "type": "string",
          "format": "uuid"
        },
        "frameId": {
          "type": "string",
          "maxLength": 120
        },
        "nodeId": {
          "type": "string",
          "maxLength": 120
        }
      },
      "required": [
        "snapshotId",
        "pageId",
        "nodeId"
      ],
      "additionalProperties": false
    },
    "CriterionResult": {
      "type": "object",
      "properties": {
        "criterionId": {
          "type": "string",
          "maxLength": 64
        },
        "result": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "not_evaluated",
            "unknown"
          ]
        },
        "reason": {
          "type": "string",
          "maxLength": 2000
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "maxItems": 30,
          "minItems": 0
        }
      },
      "required": [
        "criterionId",
        "result",
        "reason",
        "evidenceRefs"
      ],
      "additionalProperties": false
    },
    "Artifact": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "projectId": {
          "type": "string",
          "format": "uuid"
        },
        "runId": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "type": "string",
          "enum": [
            "screenshot",
            "trace",
            "rrweb",
            "network",
            "console",
            "export",
            "other"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "available",
            "degraded",
            "missing",
            "failed"
          ]
        },
        "bytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "contentUrl": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri-reference"
            },
            {
              "type": "null"
            }
          ]
        },
        "redaction": {
          "type": "string",
          "enum": [
            "applied",
            "not_needed",
            "failed"
          ]
        },
        "error": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "taskId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "stepId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "caseId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "snapshotId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "projectId",
        "runId",
        "kind",
        "status",
        "bytes",
        "sha256",
        "contentUrl",
        "redaction",
        "error",
        "createdAt",
        "taskId",
        "stepId",
        "caseId",
        "snapshotId"
      ],
      "additionalProperties": false
    },
    "CandidateCase": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 200,
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "maxLength": 4000
        },
        "preconditions": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1000
          },
          "maxItems": 20,
          "minItems": 0
        },
        "outline": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1500
          },
          "maxItems": 30,
          "minItems": 1
        },
        "criteria": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Criterion"
          },
