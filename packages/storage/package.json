{
  "name": "@localqa/storage",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src scripts test",
    "format": "prettier --write package.json tsconfig.json src scripts test README.md",
    "format:check": "prettier --check package.json tsconfig.json src scripts test README.md",
    "test": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@localqa/contracts": "workspace:*",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
