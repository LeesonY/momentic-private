{
  "name": "@localqa/model-gateway",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm build && pnpm --filter @localqa/agents build && node --test --test-concurrency=1 scripts/verify.mjs test/probe-budget.test.mjs test/capability-probe.test.mjs"
  },
  "dependencies": {
    "@localqa/contracts": "workspace:*",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "5.9.3"
  }
}
