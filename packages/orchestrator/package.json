{
  "name": "@localqa/orchestrator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "lint": "eslint src test",
    "format": "prettier --write package.json tsconfig.json src test README.md",
    "format:check": "prettier --check package.json tsconfig.json src test README.md"
  },
  "dependencies": {
    "@localqa/contracts": "workspace:*",
    "@localqa/domain": "workspace:*",
    "@localqa/storage": "workspace:*",
    "@localqa/model-gateway": "workspace:*",
    "@localqa/agents": "workspace:*"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
