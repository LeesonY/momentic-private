# ==============================================================================
# LocalQA Production Environment Configuration Template (.env.example)
#
# References:
#   - packages/contracts/src/config.ts (CONFIG_KEYS definition)
#   - docs/02-technical-design.md (§1, §11, §12)
#
# INSTRUCTIONS:
# Copy this file to .env before starting services: `cp .env.example .env`
# Sensitive credentials MUST be supplied through protected file mounts (/run/secrets),
# never hardcoded in version control or Docker images.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Service & Database Configuration (CONFIG_KEYS)
# ------------------------------------------------------------------------------

# Database connection URL (Required, Sensitive).
# Password must match secrets/postgres_password. Current app needs an inline URL;
# protect deploy/.env with mode 0600 and never commit it. DATABASE_URL_FILE is not wired.
DATABASE_URL=postgresql://localqa:REPLACE_WITH_DB_PASSWORD@postgres:5432/localqa

# Public HTTPS origin for web UI and API routing (Required).
# Must be a valid HTTPS URI; HTTP is redirected by gateway reverse proxy.
PUBLIC_ORIGIN=https://localqa.internal

# Server-side persistent storage directory for artifacts, screenshots, and export zips (Required).
DATA_DIR=/var/localqa/data

# Master Key Encryption Key (KEK) file path (Required, Sensitive, Protected File).
# JSON file format: {"activeVersion":1, "keys":{"1":"<base64-32-random-bytes>"}}
# Permissions: strictly 0400 or 0600 owned by runtime user.
MASTER_KEY_FILE=/run/secrets/kek.json

# Internal Worker service identity credentials file (Required, Sensitive, Protected File).
# Used by Worker pool to authenticate to internal coordinator and lease endpoints.
WORKER_IDENTITY_FILE=/run/secrets/worker_identity.json

# ------------------------------------------------------------------------------
# Worker Pool & Task Scheduling Limits
# ------------------------------------------------------------------------------

# Maximum concurrent browser sessions allowed per worker host (Default: 4).
BROWSER_SLOTS=4

# Task lease duration in seconds (Default: 45). Worker must renew lease via heartbeat.
JOB_LEASE_SECONDS=45

# Worker heartbeat interval in seconds (Default: 10). Must be strictly less than lease seconds.
JOB_HEARTBEAT_SECONDS=10

# Worker polling interval in milliseconds for task queue checks (Default: 1000). Max: 1000ms.
JOB_POLL_INTERVAL_MS=1000

# User interaction input waiting deadline in seconds (Default: 300).
INPUT_WAIT_TIMEOUT_SECONDS=300

# OTP verification code waiting deadline in seconds (Default: 300).
# Max OTP waiting contexts capped at floor(BROWSER_SLOTS / 2) to prevent pool starvation.
OTP_CONTEXT_WAIT_TIMEOUT_SECONDS=300

# ------------------------------------------------------------------------------
# Retention & Garbage Collection (GC) Policies (in Days)
# ------------------------------------------------------------------------------

# SSE / Run event history retention in days (Required, explicit choice by deploy owner).
EVENT_RETENTION_DAYS=30

# Full execution report and summary retention in days (Default: 90).
REPORT_RETENTION_DAYS=90

# Binary artifact (screenshots, traces, recordings) retention in days (Default: 30).
ARTIFACT_RETENTION_DAYS=30

# Immutable security audit log retention in days (Default: 180).
AUDIT_RETENTION_DAYS=180

# ------------------------------------------------------------------------------
# PostgreSQL Infrastructure Settings
# ------------------------------------------------------------------------------
POSTGRES_USER=localqa
POSTGRES_DB=localqa
# Password file path for PostgreSQL container initialization
POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password

# ------------------------------------------------------------------------------
# Gateway & Host Port Bindings
# ------------------------------------------------------------------------------
GATEWAY_HTTP_PORT=80
GATEWAY_HTTPS_PORT=443

# Non-root user ID and Group ID for Worker Chromium container
# Target application image must create this UID/GID and grant it access to writable volumes.
LOCALQA_UID=1001
LOCALQA_GID=1001

# Supply an application worker image based on pinned Playwright v1.63.0-noble,
# including compiled worker code, dependencies and the health-probe script.
LOCALQA_WORKER_IMAGE=localqa-worker:unbuilt
