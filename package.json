{
  "name": "localqa",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.0",
  "engines": {
    "node": ">=24 <27",
    "pnpm": "10.34.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "contracts:generate": "pnpm --filter @localqa/contracts generate",
    "contracts:check": "pnpm --filter @localqa/contracts check && pnpm --filter @localqa/web check:client",
    "lint": "eslint .",
    "format": "prettier --write package.json pnpm-workspace.yaml tsconfig.base.json eslint.config.mjs .prettierrc.json .github/workflows/ci.yml \"packages/*/package.json\" \"apps/*/package.json\" \"packages/*/{src,test,scripts}/**/*.{ts,mjs,json}\" \"apps/*/{src,test,scripts}/**/*.{ts,tsx,mjs,json,css,html}\" \"apps/cli/*.mjs\" \"deploy/**/*.mjs\" \"scripts/**/*.{mjs,json}\"",
    "format:check": "prettier --check --end-of-line auto package.json pnpm-workspace.yaml tsconfig.base.json eslint.config.mjs .prettierrc.json .github/workflows/ci.yml \"packages/*/package.json\" \"apps/*/package.json\" \"packages/*/{src,test,scripts}/**/*.{ts,mjs,json}\" \"apps/*/{src,test,scripts}/**/*.{ts,tsx,mjs,json,css,html}\" \"apps/cli/*.mjs\" \"deploy/**/*.mjs\" \"scripts/**/*.{mjs,json}\"",
    "test": "pnpm build && pnpm test:unit",
    "test:unit": "node scripts/test-unit.mjs",
    "test:api-security": "node --test apps/api/test/cors.test.mjs",
    "test:auth-pure": "node --test packages/browser/test/auth-state.test.mjs packages/browser/test/private-auth.test.mjs packages/browser/test/policy-origin.test.mjs apps/worker/test/auth-import.test.mjs apps/worker/test/auth-runtime.test.mjs apps/worker/test/auth-services.test.mjs",
    "test:auth-browser": "node --test packages/browser/test/trusted-auth-primitives.test.mjs apps/worker/test/auth-import-browser.test.mjs apps/worker/test/auth-import-task.test.mjs",
    "test:auth-pg": "node --test apps/worker/test/auth-pg-chromium.integration.mjs",
    "test:ci-key": "node --test apps/api/test/t11-ci-keys.test.mjs apps/cli/localqa.test.mjs",
    "test:schedule": "node --test apps/api/test/t11-scheduler.test.mjs",
    "test:integration": "pnpm --filter @localqa/browser test && pnpm --filter @localqa/storage test",
    "acceptance": "node scripts/acceptance.mjs",
    "localqa": "node apps/cli/localqa.mjs",
    "typecheck": "pnpm -r typecheck",
    "ci": "pnpm contracts:check && pnpm lint && pnpm format:check && pnpm build && pnpm typecheck && pnpm test:unit"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  }
}
