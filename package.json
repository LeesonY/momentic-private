{
  "name": "localqa",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.0",
  "engines": {
    "node": ">=24 <27",
    "pnpm": "10.34.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "contracts:generate": "pnpm --filter @localqa/contracts generate",
    "contracts:check": "pnpm --filter @localqa/contracts check",
    "lint": "eslint eslint.config.mjs packages/contracts/src packages/contracts/scripts packages/contracts/test packages/storage/src packages/storage/scripts packages/storage/test packages/browser/src packages/browser/test packages/model-gateway/src packages/model-gateway/scripts packages/agents/src packages/report/src packages/report/scripts packages/report/test apps/web/src apps/web/scripts",
    "format": "prettier --write package.json pnpm-workspace.yaml tsconfig.base.json eslint.config.mjs .prettierrc.json .github/workflows/ci.yml \"packages/*/package.json\" \"packages/*/{src,test,scripts}/**/*.{ts,mjs,json}\" \"apps/*/{src,test,scripts}/**/*.{ts,tsx,mjs,json,css,html}\"",
    "format:check": "prettier --check package.json pnpm-workspace.yaml tsconfig.base.json eslint.config.mjs .prettierrc.json .github/workflows/ci.yml \"packages/*/package.json\" \"packages/*/{src,test,scripts}/**/*.{ts,mjs,json}\" \"apps/*/{src,test,scripts}/**/*.{ts,tsx,mjs,json,css,html}\"",
    "test": "pnpm --filter @localqa/contracts test && pnpm --filter @localqa/model-gateway test",
    "test:integration": "pnpm --filter @localqa/browser test && pnpm --filter @localqa/storage test",
    "typecheck": "pnpm -r typecheck",
    "ci": "pnpm contracts:check && pnpm lint && pnpm format:check && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  }
}
